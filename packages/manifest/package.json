{
  "name": "tce-manifest",
  "description": "Content element manifest",
  "author": "Studion <info@gostudion.com>",
  "type": "module",
  "version": "0.0.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "nuke": "pnpm dlx del-cli dist node_modules",
    "nuke:dist": "pnpm dlx del-cli dist",
    "prepublish": "pnpm build"
  },
  "dependencies": {
    "@tailor-cms/cek-common": "3.0.5"
  },
  "devDependencies": {
    "@tailor-cms/eslint-config": "3.0.5",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3"
  },
  "tsdown": {
    "target": "node26",
    "fixedExtension": false
  },
  "engines": {
    "node": ">=26"
  }
}
